name: Build Android APK

on:
  workflow_dispatch:
  push:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Build APK
        uses: docker://ghcr.io/kivy/buildozer:latest
        with:
          args: android debug
        env:
          BUILDOZER_WARN_ON_ROOT: 0
        working-directory: app

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: KING-REIGNS-WORD-BUILDER-APK
          path: app/bin/*.apk
